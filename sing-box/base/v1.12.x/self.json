{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": false
    },
    "clash_api": {
      "default_mode": "rule",
      "external_controller": "0.0.0.0:9090",
      "external_ui": "ui",
      "external_ui_download_detour": "手动选择",
      "external_ui_download_url": "https://github.com/MetaCubeX/yacd/archive/gh-pages.zip"
    }
  },
  "dns": {
    "servers": [
      {
        "address": "https://8.8.8.8/dns-query",
        "detour": "手动选择",
        "tag": "google-dns"
      },
      {
        "address": "https://1.1.1.1/dns-query",
        "detour": "手动选择",
        "tag": "cloudflare-dns"
      },
      {
        "address": "119.29.29.29",
        "detour": "direct",
        "tag": "dnspod-dns"
      },
      {
        "address": "223.5.5.5",
        "detour": "direct",
        "tag": "aliyun-dns"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "geosite-cn"
        ],
        "server": "dnspod-dns"
      },
      {
        "rule_set": [
          "personal-proxy",
          "personal-specify-proxy",
          "geosite-!cn"
        ],
        "server": "google-dns"
      },
      {
        "outbound": "any",
        "server": "dnspod-dns"
      }
    ],
    "final": "google-dns",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "::",
      "listen_port": 53,
      "network": "udp"
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 7890
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.0/30"
      ],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "stack": "system",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "手动选择",
      "outbounds": [
        "include://(.*)",
        "tag://direct"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [
        "include://(.*)"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "tolerance": 50,
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "Apple服务",
      "outbounds": [
        "tag://direct",
        "tag://手动选择",
        "tag://自动选择",
        "include://(.*)"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "AI服务",
      "outbounds": [
        "tag://手动选择",
        "tag://自动选择",
        "include://(.*)",
        "tag://direct"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Google服务",
      "outbounds": [
        "tag://手动选择",
        "tag://自动选择",
        "include://(.*)"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Telegram服务",
      "outbounds": [
        "tag://手动选择",
        "tag://自动选择",
        "include://(.*)"
      ],
      "interrupt_exist_connections": true
