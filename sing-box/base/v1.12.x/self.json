    {
      "type": "selector",
      "tag": "Microsoft服务",
      "outbounds": [
        "tag://手动选择",
        "tag://自动选择",
        "include://(.*)",
        "tag://direct"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "海外媒体",
      "outbounds": [
        "tag://手动选择",
        "tag://自动选择",
        "include://(.*)",
        "tag://direct"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "兜底访问",
      "outbounds": [
        "tag://手动选择",
        "tag://自动选择",
        "tag://direct",
        "include://(.*)"
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "direct",
      "type": "direct"
    }
